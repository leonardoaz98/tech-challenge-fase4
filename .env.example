# Opcional. Copie para .env só se quiser mudar o padrão. O .env nunca vai para o git.
# Sem o Ollama no ar, o sistema roda em modo "só recuperação" (busca + evidências, sem resposta gerada).
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# GPU com pouca VRAM livre (ex.: 6 GB compartilhados no WSL2): limita as camadas
# na GPU e o tamanho do lote para evitar "cudaMalloc out of memory". Deixe em branco
# para o Ollama decidir sozinho (recomendado em GPUs com VRAM folgada).
# OLLAMA_NUM_GPU=10
# OLLAMA_NUM_BATCH=128
# Se a VM do WSL2 travar durante a geração, use só a CPU (e suba o servidor com
# CUDA_VISIBLE_DEVICES=-1 ollama serve):
# OLLAMA_NUM_GPU=0
